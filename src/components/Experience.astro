---
import ExperienceItem from "./ExperienceItem.astro";

const experience = [
    {
        title: "Frontend Developer - ISACODE CIA LTDA",
        description: "Highly proficient in UI design and optimization using React and Material-UI, with extensive experience in developing responsive web applications. Expertise in building scalable and maintainable applications using React and Redux for efficient state management. Skilled in creating reusable React components that promote code reusability and consistency. Led the development of the VENDEX project (Electronic Billing Management) using Angular 8, while applying React-based approaches to frontend architecture. Strong background in cloud server management, with advanced knowledge in Power BI for data visualization. In-depth experience in SQL queries, PostgreSQL database optimization, and database schema design for efficient data management.",
        link: "",
        date: "2024 - 2025",
    },
    {
        title: "Professor of Fundamentals of Programming - METROPOLITANA UNIVERSITY",
        description: "Teaching introductory-level classes to technology students. Focused on building a strong foundation in programming through fundamental concepts such as propositional logic, pseudocode, flowcharts, and the use of the PSeInt tool. Introduced students to Java and Python for web programming, along with database concepts, fostering logical and structured thinking as essential skills for programming.",
        link: "",
        date: "2024 - 2025",
    },
    {
        title: "Full Stack Developer - Freelance",
        description: "Developer Contractor with experience in the development and maintenance of POS systems. Proficient in JavaScript, PHP, and SQL Server for building and optimizing backend and frontend functionalities. Skilled in data visualization and reporting using Power BI to enhance decision-making and system performance.",
        link: "",
        date: "2022 - 2023",
    },
    {
        title: "Software Developer - NEXEL SOLUCIONES",
        description: "Frontend development of responsive web applications using React and Vue.js, integrating REST APIs and managing state efficiently. Experience in mobile app development with Android Studio and backend integration via Firebase. Provided support for Java/Tomcat applications and monitored systems using PRTG. Managed incidents following ITIL standards and collaborated on projects using Git and Scrum methodology.",
        link: "",
        date: "2021 - 2022",
    },
];

---

<ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3.5">
    {
        experience.map(exp=> (
            <li class="mb-10 ms-4">
                <ExperienceItem {...exp} />
            </li>
        ))
    }
</ol>
