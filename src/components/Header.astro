---
const navItems = [
  {
    title: "Home",
    label: "home",
    url: "#home",
  },
  {
    title: "Experience",
    label: "experience",
    url: "#experience",
  },
  {
    title: "Projects",
    label: "projects",
    url: "#projects",
  },
  {
    title: "Skills",
    label: "skills",
    url: "#skills",
  },
  {
    title: "Publications/About me",
    label: "publications",
    url: "#publications",
  },
];
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-sm font-medium rounded-full text-white/90 justify-center items-center"
  >
    {
      navItems.map((link, index) => (
        <a
          class={`relative block px-2 py-2 transition hover:text-yellow-400 
          ${index > 3 ? "hidden md:block" : ""}
        `}
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-yellow-500");
            } else {
              item.classList.remove("text-yellow-500");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.2,
    });
    // Justo después de crear el observer
    const highlightSection = () => {
      const scrollPos = window.scrollY;
      sections.forEach((section) => {
        const offsetTop = section.offsetTop;
        const offsetBottom = offsetTop + section.offsetHeight;

        if (scrollPos >= offsetTop - 100 && scrollPos < offsetBottom - 100) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == section.id) {
              item.classList.add("text-yellow-500");
            } else {
              item.classList.remove("text-yellow-500");
            }
          });
        }
      });
    };

    highlightSection(); // Llamar al cargar
    window.addEventListener("scroll", highlightSection); // Escuchar scroll

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Función de limpieza
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur dark:bg-gray-800/90 bg-white/20 ring-white/10;
    }
  }
</style>
